# Tunakula API — production environment template.
# Copy to your secrets manager / orchestrator; never commit real values. The API validates these at boot and
# refuses to start if a required one is missing or if it is left in a development-only mode.

# ─── Required ────────────────────────────────────────────────────────────────
# Migrating owner role (CREATEDB, NOT superuser, NOT BYPASSRLS) — runs migrations on startup.
DATABASE_OWNER_URL=postgres://tunakula:CHANGE_ME@db.internal:5432/tunakula
# Least-privilege application role the API connects as (NOT superuser, NOT BYPASSRLS) — RLS applies to it.
DATABASE_URL=postgres://tunakula_app:CHANGE_ME@db.internal:5432/tunakula
DATABASE_APP_ROLE=tunakula_app
# Session-token signing secret — 32+ random characters. Rotating it invalidates all existing sessions.
TUNAKULA_TOKEN_SECRET=CHANGE_ME_32_OR_MORE_RANDOM_CHARS

# ─── Production essentials ───────────────────────────────────────────────────
PORT=8080
# Browser origins allowed by CORS: the admin console and the customer website. Comma-separated, no trailing slash.
TUNAKULA_CONSOLE_ORIGINS=https://admin.tunakula.com,https://tunakula.com
# Behind a load balancer: trust X-Forwarded-* so the client IP (and the rate limit) are correct.
TUNAKULA_TRUST_PROXY=1
# Per-instance request cap/minute (pair with an edge limiter/WAF for the fleet). Omit to disable.
TUNAKULA_RATE_LIMIT_RPM=600
# Regional API hosts used in signed payloads (JSON). Keep in sync with your DNS.
TUNAKULA_API_HOSTS={"europe-west2":"https://eu.api.tunakula.com","africa-south1":"https://af.api.tunakula.com"}

# ─── Observability ───────────────────────────────────────────────────────────
# Expose Prometheus metrics at GET /metrics for a scraper. Restrict it at the edge (internal network / path
# rule); set a token to also require Authorization: Bearer <token> on the endpoint.
TUNAKULA_METRICS=1
TUNAKULA_METRICS_TOKEN=CHANGE_ME_SCRAPE_TOKEN

# ─── Messaging (sign-in codes) — REQUIRED in production ──────────────────────
# Without a provider the API refuses to start unless TUNAKULA_DEV_OTP=1 (development only).
TUNAKULA_MESSAGING_PROVIDER=twilio
TUNAKULA_TWILIO_ACCOUNT_SID=CHANGE_ME
TUNAKULA_TWILIO_AUTH_TOKEN=CHANGE_ME
TUNAKULA_TWILIO_SMS_FROM=+10000000000
# Optional WhatsApp sender.
#TUNAKULA_TWILIO_WHATSAPP_FROM=whatsapp:+10000000000

# ─── Email (SMTP) — optional; enables the `email` notification/broadcast channel ─────────────
# Set host + from to turn email on. SECURE=1 for implicit TLS (port 465); otherwise STARTTLS is used
# opportunistically (ports 587/25). User/pass enable AUTH LOGIN. Without these, the email channel logs.
#TUNAKULA_SMTP_HOST=smtp.your-provider.com
#TUNAKULA_SMTP_PORT=587
#TUNAKULA_SMTP_SECURE=0
#TUNAKULA_SMTP_USER=CHANGE_ME
#TUNAKULA_SMTP_PASS=CHANGE_ME
#TUNAKULA_SMTP_FROM=Tunakula <no-reply@tunakula.com>

# ─── Payments — configure at least one connector for the market you launch ───
# Keys may instead be added at runtime from Admin → Integrations; env is the bootstrap path.
#BITRIPAY_SECRET_KEY=CHANGE_ME
#BITRIPAY_WEBHOOK_SECRET=CHANGE_ME
#KODA_SECRET_KEY=CHANGE_ME
#KODA_WEBHOOK_SECRET=CHANGE_ME
#STRIPE_SECRET_KEY=sk_live_CHANGE_ME
#STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ─── Optional: routing (delivery distance/time) ──────────────────────────────
# With neither set, the API uses a straight-line estimate (works, less accurate).
#TUNAKULA_GOOGLE_ROUTES_KEY=CHANGE_ME
#TUNAKULA_OSRM_URL=https://osrm.internal

# ─── Optional: web push notifications ────────────────────────────────────────
#TUNAKULA_VAPID_PUBLIC_KEY=CHANGE_ME
#TUNAKULA_VAPID_PRIVATE_KEY=CHANGE_ME
#TUNAKULA_VAPID_SUBJECT=mailto:info@tunakula.com

# ─── Optional: AI agents (hosted model) ──────────────────────────────────────
# Without a key, every AI feature falls back to its deterministic in-house brain — the platform runs fully.
#TUNAKULA_ASSISTANT_API_KEY=CHANGE_ME
#TUNAKULA_ASSISTANT_PROVIDER=anthropic
#TUNAKULA_ASSISTANT_MODEL=claude-opus-5-5

# ─── Tuning ──────────────────────────────────────────────────────────────────
# Background operations loop interval (ms): dispatch offers, refunds, loyalty, subscriptions, plan billing.
#TUNAKULA_DISPATCH_MS=5000

# ─── DEVELOPMENT ONLY — never set these in production ────────────────────────
# TUNAKULA_SANDBOX_PAYMENTS=1   # a fake payment connector that always succeeds
# TUNAKULA_DEV_OTP=1            # logs the sign-in code instead of sending it
