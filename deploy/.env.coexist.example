# Tunakula coexist deploy — copy this to deploy/.env.staging and fill it in.
# Point each subdomain's DNS A record at this VPS's public IP BEFORE requesting TLS certificates.

# Your three subdomains (the bare domain is the customer storefront).
API_DOMAIN=api.yourdomain.com
CUSTOMER_DOMAIN=yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com

# A long random secret that signs sign-in tokens. Generate one with:
#   head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 40 ; echo
TUNAKULA_TOKEN_SECRET=
