# Tunakula coexist deploy — copy this to deploy/.env.staging and fill it in.
# Point each subdomain's DNS A record at this VPS's public IP BEFORE requesting TLS certificates.

# The new platform's domains — the tunakula.com apex, beside the old system on cd./drc.tunakula.com.
API_DOMAIN=api.tunakula.com
CUSTOMER_DOMAIN=tunakula.com
ADMIN_DOMAIN=admin.tunakula.com

# A long random secret that signs sign-in tokens. Generate one with:
#   head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 40 ; echo
TUNAKULA_TOKEN_SECRET=

# OPTIONAL — native-app push (React Native / Expo). Leave blank to start: Expo delivers to iOS and
# Android behind one token with no Apple/FCM credentials. Set this to an Expo access token only to
# raise production rate limits and tie pushes to your Expo account.
#   TUNAKULA_EXPO_ACCESS_TOKEN=
